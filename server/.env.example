PORT=5000
# Optional: set to use MongoDB. Leave empty to run with the built-in file store.
MONGO_URI=
# Optional: set all three to store uploads on Cloudinary. Otherwise they are saved locally in /uploads.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Used to sign auth tokens. Change in production.
JWT_SECRET=change-me
# Admin account (created automatically on first start). Only the admin can upload/delete posts.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ADMIN_EMAIL=admin@anime.local
